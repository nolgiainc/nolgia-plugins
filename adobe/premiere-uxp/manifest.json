{
  "manifestVersion": 5,
  "id": "com.nolgia.premiere.transcripts",
  "name": "NOLGIA Transcripts",
  "version": "0.1.4",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:47731",
        "http://127.0.0.1:47732",
        "http://127.0.0.1:47733"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "transcripts",
      "label": { "default": "NOLGIA Transcripts" },
      "minimumSize": { "width": 220, "height": 120 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 200 },
      "preferredFloatingSize": { "width": 300, "height": 220 }
    }
  ]
}
