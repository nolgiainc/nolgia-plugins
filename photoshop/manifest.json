{
  "manifestVersion": 5,
  "id": "com.nolgia.photoshop",
  "name": "NOLGIA for Photoshop",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.nolgia.ai",
        "https://storage.googleapis.com",
        "https://*.storage.googleapis.com"
      ]
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    },
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "nolgia",
      "label": {
        "default": "NOLGIA"
      },
      "minimumSize": { "width": 240, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 320, "height": 600 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 1.25, 1.5, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 1.25, 1.5, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}
